// QuickErrand database schema.
// Four models, two enums, see "QuickErrand Implementation Plan.md" §2 for
// the reasoning. Resist the urge to add fields "while we're in here"; every
// addition here is a migration and a decision, not a free action.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes the connection URL here, it's read from
// prisma.config.ts (CLI) and passed to PrismaClient via a driver adapter
// at runtime (lib/prisma.ts). See CLAUDE.md for why.
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  // Runner-only fields, left null for USER/ADMIN accounts rather than
  // split into a separate RunnerProfile table. A single account can only
  // hold one role (see plan §1), so there's no join to normalize away.
  category    Category?
  bio         String?
  isAvailable Boolean   @default(true)

  // A runner's payout details for BANK_TRANSFER tasks, set once and reused
  // across every task rather than re-entered each time. Purely
  // informational, see Task.paidAt below, nothing here moves money.
  bankAccountNumber String?
  bankName          String?

  tasksPosted      Task[]   @relation("PostedTasks")
  tasksRunning     Task[]   @relation("RunnerTasks")
  bids             Bid[]
  notifications    Notification[]
  ratingsGiven     Rating[] @relation("RatingsGiven")
  ratingsReceived  Rating[] @relation("RatingsReceived")
}

enum Role {
  USER
  RUNNER
  ADMIN
}

enum Category {
  GENERAL_ERRAND
  PLUMBING
  CARPENTRY
  ELECTRICAL
  CLEANING
  OTHER
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  category    Category
  location    String
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  posterId String
  poster   User   @relation("PostedTasks", fields: [posterId], references: [id])

  runnerId String?
  runner   User?   @relation("RunnerTasks", fields: [runnerId], references: [id])

  // Coordination only, never a transaction, see CLAUDE.md and TASKS.md
  // 3.6 for the scope boundary. `price` is the poster's stated asking
  // price; nothing computes or moves it. `paidAt`/`paymentConfirmedAt` are
  // a two-step record (poster marks paid, then runner confirms receipt),
  // not a payment flow.
  price         Int
  paymentMethod PaymentMethod

  paidAt             DateTime?
  paymentConfirmedAt DateTime?

  // Up to two per errand: the poster rates the runner and the runner rates
  // the poster, one each (see the unique index on Rating).
  ratings Rating[]
  bids    Bid[]

  @@index([status])
  @@index([category])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

// PENDING -> ACCEPTED -> IN_PROGRESS -> COMPLETED, with CANCELLED reachable
// only from PENDING or ACCEPTED. The only place that may write this field
// is updateTaskStatus() in lib/taskStatus.ts, see CLAUDE.md.
enum TaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Rating {
  id        String   @id @default(cuid())
  score     Int // 1-5, enforced at the API boundary, not the DB
  comment   String?
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  ratedById String
  ratedBy   User   @relation("RatingsGiven", fields: [ratedById], references: [id])

  ratedUserId String
  ratedUser   User   @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  // One rating per rater per errand. This index is the real guarantee, the
  // checks in lib/taskRating.ts only give a readable message first.
  @@unique([taskId, ratedById])
  @@index([ratedUserId])
}

enum BidStatus {
  OPEN
  AWARDED
  NOT_AWARDED
}

// A runner's bid on a PENDING errand. Any number of runners can bid, one
// live bid each (changing it updates the row). The poster reviews the bids
// and awards one, which assigns that runner at the bid price and marks the
// rest NOT_AWARDED (see awardBid in lib/taskStatus.ts). `counterPrice` is
// the poster's counter to this specific bid, if they made one.
model Bid {
  id           String    @id @default(cuid())
  price        Int
  counterPrice Int?
  status       BidStatus @default(OPEN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  runnerId String
  runner   User   @relation(fields: [runnerId], references: [id])

  @@unique([taskId, runnerId])
  @@index([taskId])
}

// Something that happened that the user should hear about: a bid arrived,
// an errand was awarded to them (or to someone else). Stored rather than
// derived, because "you weren't awarded" is an event, not a state.
model Notification {
  id        String    @id @default(cuid())
  message   String
  href      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}
