# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string. Works with a local Postgres instance or a
# managed provider (Neon, Supabase). See plan §7 Phase 4 for deploy targets.
# Use sslmode=verify-full for hosted databases like Neon. `require` works
# today but newer pg versions warn that its meaning is about to change.
# Example: postgresql://user:password@host/dbname?sslmode=verify-full
DATABASE_URL=

# NextAuth (generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
